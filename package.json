{
  "name": "flop-doctor",
  "private": true,
  "version": "1.0.0",
  "description": "Diagnoses why a creator's short-form videos flop, with receipts, and writes the next three to post.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/coldrazer/flopdoctor"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "html-to-image": "^1.11.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
