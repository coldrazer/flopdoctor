# Oriane — direct (hackathon key) or via Firecrawl Alexandria
ORIANE_MODE=direct
ORIANE_API_KEY=
ORIANE_BASE_URL=            # [CONFIRM at kickoff]
ORIANE_PATH_TEMPLATE=/v1/{platform}/{capability}   # [CONFIRM at kickoff]
FIRECRAWL_API_KEY=          # fallback: set ORIANE_MODE=firecrawl

# GMI Cloud (OpenAI-compatible)
GMI_API_KEY=
GMI_MODEL=zai-org/GLM-5.1-FP8        # pick the strongest JSON-reliable model in the catalog
GMI_MODEL_FAST=
GMI_BASE_URL=https://api.gmi-serving.com/v1
